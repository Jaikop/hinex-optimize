{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Changes the render distance without rebuilding every chunk, so the world never disappears, and can lower it automatically to keep your FPS. Built for the new Vulkan-era renderer. Source: https://github.com/Jaikop/hinex-optimize",
  "authors": [
    "Jaikop"
  ],
  "contact": {
    "homepage": "https://github.com/Jaikop/hinex-optimize",
    "sources": "https://github.com/Jaikop/hinex-optimize",
    "issues": "https://github.com/Jaikop/hinex-optimize/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/hinexoptimize/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.JAKOP.hinexOptimize.platform.fabric.HinexOptimizeFabric"
    ],
    "client": [
      "me.JAKOP.hinexOptimize.platform.fabric.HinexOptimizeFabricClient"
    ]
  },
  "mixins": [
    "hinexoptimize.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=25"
  },
  "suggests": {
    "fabric-api": "*"
  }
}
